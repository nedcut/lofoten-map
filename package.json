{
  "name": "lofoten-logbook",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "e2e:serve": "next build && next start",
    "ci": "npm run lint && npm run typecheck && npm run test",
    "r2:migrate": "node scripts/migrate-media-to-r2.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1090.0",
    "@aws-sdk/s3-request-presigner": "3.1090.0",
    "@neondatabase/neon-js": "0.6.2-beta",
    "@turf/along": "^7.4.0",
    "@turf/bearing": "^7.4.0",
    "@turf/destination": "^7.3.5",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/line-slice": "^7.4.0",
    "@turf/nearest-point-on-line": "^7.4.0",
    "@turf/point-to-line-distance": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "exifreader": "^4.45.0",
    "lucide-react": "^1.46.0",
    "mapbox-gl": "^3.30.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/mapbox-gl": "^3.5.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
